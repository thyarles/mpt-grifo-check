{
  "manifest_version": 3,
  "name": "MPT Grifo Check",
  "version": "0.1.0",
  "description": "Calcula o saldo do Grifo.",

  "icons": {
    "16": "icons/grifo_16.png",
    "48": "icons/grifo_48.png",
    "128": "icons/grifo_128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://grifo.mpt.mp.br/*"],
      "js": [
        "jquery-3.2.1.min.js",
        "js-cookie.min.js",
        "jquery.mask.min.js",
        "jquery-ui.min.js",
        "constants.js",
        "utils.js",
        "grifo-check.js"
      ],
      "run_at": "document_idle"
    }
  ]
}